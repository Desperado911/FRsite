        lines {
          text: "    answer: \"\320\255\321\202\320\276 \321\201\320\260\320\274\320\260\321\217 \321\207\320\260\321\201\321\202\320\260\321\217 \321\201\320\270\321\202\321\203\320\260\321\206\320\270\321\217 (\320\260\320\275\320\276\320\267\320\276\320\263\320\275\320\276\320\267\320\270\321\217 \342\200\224 \320\276\321\202\321\200\320\270\321\206\320\260\320\275\320\270\320\265 \320\261\320\276\320\273\320\265\320\267\320\275\320\270). \320\227\320\260\321\201\321\202\320\260\320\262\320\273\321\217\321\202\321\214 \321\201\320\270\320\273\320\276\320\271 \320\267\320\260\320\277\321\200\320\265\321\211\320\265\320\275\320\276 \320\267\320\260\320\272\320\276\320\275\320\276\320\274 \320\270 \320\275\320\265\321\215\321\204\321\204\320\265\320\272\321\202\320\270\320\262\320\275\320\276. \320\234\321\213 \320\277\321\200\320\265\320\264\320\273\320\260\320\263\320\260\320\265\320\274 \321\203\321\201\320\273\321\203\320\263\321\203 \'\320\230\320\275\321\202\320\265\321\200\320\262\320\265\320\275\321\206\320\270\321\217\'. \320\235\320\260\321\210\320\260 \320\274\320\276\320\261\320\270\320\273\321\214\320\275\320\260\321\217 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\320\260\321\217 \320\263\321\200\321\203\320\277\320\277\320\260 \320\277\321\200\320\270\320\265\320\267\320\266\320\260\320\265\321\202 \320\275\320\260 \320\264\320\276\320\274 \320\270 \320\277\321\200\320\276\320\262\320\276\320\264\320\270\321\202 \320\264\320\265\320\273\320\270\320\272\320\260\321\202\320\275\321\203\321\216 \320\261\320\265\321\201\320\265\320\264\321\203 \320\277\320\276 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\321\214\320\275\320\276\320\271 \320\274\320\265\321\202\320\276\320\264\320\270\320\272\320\265 \321\203\320\261\320\265\320\266\320\264\320\265\320\275\320\270\321\217. \320\222 92% \321\201\320\273\321\203\321\207\320\260\320\265\320\262 \320\277\320\260\321\206\320\270\320\265\320\275\321\202 \320\264\320\276\320\261\321\200\320\276\320\262\320\276\320\273\321\214\320\275\320\276 \321\201\320\276\320\263\320\273\320\260\321\210\320\260\320\265\321\202\321\201\321\217 \320\277\320\276\320\265\321\205\320\260\321\202\321\214 \320\262 \321\206\320\265\320\275\321\202\321\200 \320\277\321\200\321\217\320\274\320\276 \320\262 \321\202\320\276\321\202 \320\266\320\265 \320\264\320\265\320\275\321\214.\""
