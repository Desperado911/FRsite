    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { HelpCircle, AlertCircle, HeartHandshake, ShieldAlert, Phone, Sparkles } from \'lucide-react\';\n\ninterface MotivationGuideProps {\n  onOpenConsultation: (messageContext?: string) => void;\n}\n\nexport default function MotivationGuide({ onOpenConsultation }: MotivationGuideProps) {\n  const [activeTab, setActiveTab] = useState<\'donts\' | \'dos\' | \'intervention\'>(\'donts\');\n\n  const content = {\n    donts: {\n      title: \"\320\242\320\270\320\277\320\270\321\207\320\275\321\213\320\265 \320\276\321\210\320\270\320\261\320\272\320\270 \320\261\320\273\320\270\320\267\320\272\320\270\321\205 (\320\247\320\265\320\263\320\276 \320\264\320\265\320\273\320\260\321\202\321\214 \320\235\320\225\320\233\320\254\320\227\320\257)\",\n      subtitle: \"\320\255\321\202\320\270 \320\264\320\265\320\271\321\201\321\202\320\262\320\270\321\217 \320\275\320\265 \321\201\320\277\320\260\321\201\320\260\321\216\321\202, \320\260 \320\273\320\270\321\210\321\214 \320\277\321\200\320\276\320\264\320\273\320\265\320\262\320\260\321\216\321\202 \320\270 \321\203\321\201\321\203\320\263\321\203\320\261\320\273\321\217\321\216\321\202 \320\267\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\321\214 \320\261\320\273\320\270\320\267\320\272\320\276\320\263\320\276.\",\n      items: [\n        {\n          title: \"\320\241\320\274\321\217\320\263\321\207\320\260\321\202\321\214 \320\277\320\276\321\201\320\273\320\265\320\264\321\201\321\202\320\262\320\270\321\217 \320\270 \320\277\320\273\320\260\321\202\320\270\321\202\321\214 \320\264\320\276\320\273\320\263\320\270\",\n          desc: \"\320\237\320\276\320\263\320\260\321\210\320\260\321\217 \320\272\321\200\320\265\320\264\320\270\321\202\321\213, \321\200\320\265\321\210\320\260\321\217 \320\277\321\200\320\276\320\261\320\273\320\265\320\274\321\213 \321\201 \320\277\320\276\320\273\320\270\321\206\320\270\320\265\320\271 \320\270\320\273\320\270 \321\200\320\260\320\261\320\276\321\202\320\276\320\271, \320\262\321\213 \320\267\320\260\320\261\320\270\321\200\320\260\320\265\321\202\320\265 \321\203 \320\267\320\260\320\262\320\270\321\201\320\270\320\274\320\276\320\263\320\276 \321\210\320\260\320\275\321\201 \321\201\321\202\320\276\320\273\320\272\320\275\321\203\321\202\321\214\321\201\321\217 \321\201 \321\200\320\265\320\260\320\273\321\214\320\275\320\276\321\201\321\202\321\214\321\216. \320\237\320\276\320\272\320\260 \320\277\320\276\321\201\320\273\320\265\320\264\321\201\321\202\320\262\320\270\321\217 \320\275\320\265 \320\277\321\200\320\270\321\207\320\270\320\275\321\217\321\202 \320\265\320\274\321\203 \320\264\320\270\321\201\320\272\320\276\320\274\321\204\320\276\321\200\321\202, \321\203 \320\275\320\265\320\263\320\276 \320\275\320\265 \320\277\320\276\321\217\320\262\320\270\321\202\321\201\321\217 \320\274\320\276\321\202\320\270\320\262 \320\273\320\265\321\207\320\270\321\202\321\214\321\201\321\217.\"\n        },\n        {\n          title: \"\320\247\320\270\321\202\320\260\321\202\321\214 \320\275\320\276\321\202\320\260\321\206\320\270\320\270, \321\203\320\277\321\200\320\265\320\272\320\260\321\202\321\214 \320\270 \320\262\320\267\321\213\320\262\320\260\321\202\321\214 \320\272 \321\201\320\276\320\262\320\265\321\201\321\202\320\270\",\n          desc: \"\320\227\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\321\214 \342\200\224 \321\215\321\202\320\276 \320\261\320\276\320\273\320\265\320\267\320\275\321\214 \320\274\320\276\320\267\320\263\320\260, \320\260 \320\275\320\265 \320\276\321\202\321\201\321\203\321\202\321\201\321\202\320\262\320\270\320\265 \321\201\320\270\320\273\321\213 \320\262\320\276\320\273\320\270. \320\233\320\265\320\272\321\206\320\270\320\270 \320\270 \320\272\321\200\320\270\320\272\320\270 \320\262\321\213\320\267\321\213\320\262\320\260\321\216\321\202 \320\273\320\270\321\210\321\214 \320\276\321\202\320\262\320\265\321\202\320\275\321\203\321\216 \320\260\320\263\321\200\320\265\321\201\321\201\320\270\321\216, \320\263\320\273\321\203\320\261\320\276\320\272\320\276\320\265 \321\207\321\203\320\262\321\201\321\202\320\262\320\276 \321\201\321\202\321\213\320\264\320\260 \320\270 \320\266\320\265\320\273\320\260\320\275\320\270\320\265 \321\203\320\277\320\276\321\202\321\200\320\265\320\261\320\270\321\202\321\214 \320\276\321\207\320\265\321\200\320\265\320\264\320\275\321\203\321\216 \320\264\320\276\320\267\321\203 \320\264\320\273\321\217 \320\267\320\260\320\263\320\273\321\203\321\210\320\265\320\275\320\270\321\217 \320\261\320\276\320\273\320\270.\"\n        },\n        {\n          title: \"\320\232\320\276\320\275\321\202\321\200\320\276\320\273\320\270\321\200\320\276\320\262\320\260\321\202\321\214 \320\272\320\260\320\266\320\264\321\213\320\271 \321\210\320\260\320\263, \320\276\320\261\321\213\321\201\320\272\320\270\320\262\320\260\321\202\321\214, \321\203\320\263\321\200\320\276\320\266\320\260\321\202\321\214\",\n          desc: \"\320\223\320\270\320\277\320\265\321\200\320\272\320\276\320\275\321\202\321\200\320\276\320\273\321\214 \321\200\320\260\320\267\321\200\321\203\321\210\320\260\320\265\321\202 \320\276\321\201\321\202\320\260\321\202\320\272\320\270 \320\264\320\276\320\262\320\265\321\200\320\270\321\217. \320\227\320\260\320\262\320\270\321\201\320\270\320\274\321\213\320\271 \320\277\321\200\320\276\321\201\321\202\320\276 \320\275\320\260\321\203\321\207\320\270\321\202\321\201\321\217 \320\273\321\203\321\207\321\210\320\265 \320\262\321\200\320\260\321\202\321\214 \320\270 \320\277\321\200\321\217\321\202\320\260\321\202\321\214 \321\201\320\273\320\265\320\264\321\213. \320\237\321\203\321\201\321\202\321\213\320\265 \321\203\320\263\321\200\320\276\320\267\321\213 (\'\321\203\320\271\320\264\321\203\', \'\320\273\320\270\321\210\321\203 \320\264\320\265\320\