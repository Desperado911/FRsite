          text: "    answer: \"\320\224\320\260, \320\274\321\213 \320\263\320\260\321\200\320\260\320\275\321\202\320\270\321\200\321\203\320\265\320\274 100% \320\260\320\275\320\276\320\275\320\270\320\274\320\275\320\276\321\201\321\202\321\214. FAMILY REHUB \342\200\224 \321\215\321\202\320\276 \321\207\320\260\321\201\321\202\320\275\320\276\320\265 \321\203\321\207\321\200\320\265\320\266\320\264\320\265\320\275\320\270\320\265. \320\234\321\213 \320\275\320\265 \320\277\320\265\321\200\320\265\320\264\320\260\320\265\320\274 \320\264\320\260\320\275\320\275\321\213\320\265 \320\262 \320\263\320\276\321\201\321\203\320\264\320\260\321\200\321\201\321\202\320\262\320\265\320\275\320\275\321\213\320\265 \320\275\320\260\321\200\320\272\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\320\270\320\265 \320\264\320\270\321\201\320\277\320\260\320\275\321\201\320\265\321\200\321\213, \320\234\320\222\320\224 \320\270\320\273\320\270 \320\277\320\276 \320\274\320\265\321\201\321\202\321\203 \321\200\320\260\320\261\320\276\321\202\321\213. \320\222\321\213 \320\274\320\276\320\266\320\265\321\202\320\265 \320\277\321\200\320\276\321\205\320\276\320\264\320\270\321\202\321\214 \320\273\320\265\321\207\320\265\320\275\320\270\320\265 \320\277\320\276\320\264 \320\273\321\216\320\261\321\213\320\274 \320\262\321\213\320\274\321\213\321\210\320\273\320\265\320\275\320\275\321\213\320\274 \320\270\320\274\320\265\320\275\320\265\320\274, \320\265\321\201\320\273\320\270 \320\262\320\260\320\274 \321\202\320\260\320\272 \320\272\320\276\320\274\321\204\320\276\321\200\321\202\320\275\320\265\320\265.\""
