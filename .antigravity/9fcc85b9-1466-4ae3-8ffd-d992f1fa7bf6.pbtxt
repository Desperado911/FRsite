        lines {
          text: "    question: \"\320\224\320\265\320\271\321\201\321\202\320\262\320\270\321\202\320\265\320\273\321\214\320\275\320\276 \320\273\320\270 \320\273\320\265\321\207\320\265\320\275\320\270\320\265 \320\277\320\276\320\273\320\275\320\276\321\201\321\202\321\214\321\216 \320\260\320\275\320\276\320\275\320\270\320\274\320\275\320\276? \320\241\321\202\320\260\320\262\320\270\321\202\320\265 \320\273\320\270 \320\262\321\213 \320\275\320\260 \321\203\321\207\320\265\321\202?\","
