        }
        lines {
          text: "                        const elementPosition = elementRect - bodyRect;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        const offsetPosition = elementPosition - offset;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        window.scrollTo({ top: offsetPosition, behavior: \'smooth\' });"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
