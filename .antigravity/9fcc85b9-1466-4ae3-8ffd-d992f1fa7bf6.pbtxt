20\265\321\200\320\275\321\213\320\271 \321\201\320\275\320\270\320\274\320\276\320\272 \321\203\321\216\321\202\320\275\320\276\320\271 \320\263\320\276\321\201\321\202\320\270\320\275\320\276\320\271 \320\264\320\273\321\217 \320\263\321\200\321\203\320\277\320\277\320\276\320\262\320\276\320\271 \321\202\320\265\321\200\320\260\320\277\320\270\320\270 \321\201 \320\261\320\276\320\273\321\214\321\210\320\270\320\274\320\270 \320\276\320\272\320\275\320\260\320\274\320\270 \320\275\320\260 \321\205\320\262\320\276\320\271\320\275\321\213\320\271 \320\273\320\265\321\201 \320\270 \321\200\320\260\321\201\321\201\321\202\320\260\320\262\320\273\320\265\320\275\320\275\321\213\320\274\320\270 \320\277\320\276 \320\272\321\200\321\203\320\263\321\203 \320\274\321\217\320\263\320\272\320\270\320\274\320\270 \320\272\321\200\320\265\321\201\320\273\320\260\320\274\320\270, \320\264\320\265\320\274\320\276\320\275\321\201\321\202\321\200\320\270\321\200\321\203\321\216\321\211\320\270\320\271 \320\261\320\265\320\267\320\276\320\277\320\260\321\201\320\275\320\276\321\201\321\202\321\214 \320\270 \320\272\320\276\320\274\321\204\320\276\321\200\321\202.\n\n5. **\320\236\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\271 \320\261\320\273\320\276\320\272 \320\264\320\276\320\262\320\265\321\200\320\270\321\217 \320\270 \321\216\321\200\320\270\320\264\320\270\321\207\320\265\321\201\320\272\320\276\320\265 \321\201\320\276\320\276\321\202\320\262\320\265\321\202\321\201\321\202\320\262\320\270\320\265**:\n   * \320\236\321\204\320\276\321\200\320\274\320\273\320\265\320\275 \321\200\320\265\320\265\321\201\321\202\321\200 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\321\201\321\202\320\276\320\262 (\320\262\321\200\320\260\321\207-\320\275\320\260\321\200\320\272\320\276\320\273\320\276\320\263, \320\272\320\273\320\270\320\275\320\270\321\207\320\265\321\201\320\272\320\270\320\271 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263, \321\201\320\270\321\201\321\202\320\265\320\274\320\275\321\213\320\271 \321\201\320\265\320\274\320\265\320\271\320\275\321\213\320\271 \321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202, \320\260\321\200\321\202-\321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202) \321\201 \321\203\320\272\320\260\320\267\320\260\320\275\320\270\320\265\320\274 \320\276\320\277\321\213\321\202\320\260 \320\270 \320\276\320\261\321\200\320\260\320\267\320\276\320\262\320\260\320\275\320\270\321\217.\n   * \320\221\320\273\320\276\320\272 \321\207\320\260\321\201\321\202\320\276 \320\267\320\260\320\264\320\260\320\262\320\260\320\265\320\274\321\213\321\205 \320\262\320\276\320\277\321\200\320\276\321\201\320\276\320\262 (FAQ) \320\262 \320\262\320\270\320\264\320\265 \320\277\320\273\320\260\320\262\320\275\321\213\321\205 \320\262\321\213\320\277\320\260\320\264\320\260\321\216\321\211\320\270\321\205 \320\260\320\272\320\272\320\276\321\200\320\264\320\265\320\276\320\275\320\276\320\262 (\320\260\320\275\320\276\320\275\320\270\320\274\320\275\320\276\321\201\321\202\321\214, \320\276\321\202\321\201\321\203\321\202\321\201\321\202\320\262\320\270\320\265 \320\263\320\276\321\201\321\203\320\264\320\260\321\200\321\201\321\202\320\262\320\265\320\275\320\275\320\276\320\263\320\276 \321\203\321\207\320\265\321\202\320\260, \320\277\320\276\321\201\320\265\321\211\320\265\320\275\320\270\321\217, \320\261\320\265\320\267\320\276\320\277\320\260\321\201\320\275\320\276\321\201\321\202\321\214).\n   * \320\230\321\201\320\272\321\200\320\265\320\275\320\275\320\270\320\265 \321\201\321\202\321\200\321\203\320\272\321\202\321\203\321\200\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\265 \320\276\321\202\320\267\321\213\320\262\321\213 \321\201\320\277\320\260\321\201\320\265\320\275\320\275\321\213\321\205 \321\201\320\265\320\274\320\265\320\271 (\320\276\321\202 \320\274\320\260\320\274\321\213 \320\262\321\213\320\277\321\203\321\201\320\272\320\275\320\270\320\272\320\260, \321\201\321\203\320\277\321\200\321\203\320\263\320\276\320\262, \321\201\320\260\320\274\320\276\320\263\320\276 \321\200\320\265\320\267\320\270\320\264\320\265\320\275\321\202\320\260) \321\201 \321\203\320\272\320\260\320\267\320\260\320\275\320\270\320\265\320\274 \320\277\320\265\321\200\320\270\320\276\320\264\320\260 \321\202\321\200\320\265\320\267\320\262\320\276\321\201\321\202\320\270.\n   * \320\244\321\203\321\202\320\265\321\200 \321\201\320\276\320\264\320\265\321\200\320\266\320\270\321\202 \320\276\321\204\320\270\321\206\320\270\320\260\320\273\321\214\320\275\321\213\320\265 \320\264\320\270\321\201\320\272\320\273\320\265\320\271\320\274\320\265\321\200\321\213 \320\272\320\273\320\270\320\275\320\270\320\272\320\270, \320\275\320\276\320\274\320\265\321\200 \320\274\320\265\320\264\320\270\321\206\320\270\320\275\321\201\320\272\320\276\320\271 \320\273\320\270\321\206\320\265\320\275\320\267\320\270\320\270 \320\234\320\270\320\275\320\267\320\264\321\200\320\260\320\262\320\260 \320\240\320\244 \320\270 \320\276\320\261\321\217\320\267\320\260\321\202\320\265\320\273\321\214\320\275\320\276\320\265 \320\277\321\200\320\265\320\264\321\203\320\277\321\200\320\265\320\266\320\264\320\265\320\275\320\270\320\265: **\302\253\320\230\320\274\320\265\321\216\321\202\321\201\321\217 \320\277\321\200\320\276\321\202\320\270\320\262\320\276\320\277\320\276\320\272\320\260\320\267\320\260\320\275\320\270\321\217. \320\235\320\265\320\276\320\261\321\205\320\276\320\264\320\270\320\274\320\260 \320\272\320\276\320\275\321\201\321\203\320\273\321\214\321\202\320\260\321\206\320\270\321\217 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\321\201\321\202\320\260\302\273**, \321\207\321\202\320\276 \320\264\320\265\320\273\320\260\320\265\321\202 \320\273\321\215\320\275\320\264\320\270\320\275\320\263 \320\260\320\262\321\202\320\276\321\200\320\270\321\202\320\265\321\202\320\275\321\213\320\274 \320\270 \321\216\321\200\320\270\320\264\320\270\321\207\320\265\321\201\320\272\320\270 \320\264\320\276\321\201\321\202\320\276\320\262\320\265\321\200\320\275\321\213\320\274.\n"
