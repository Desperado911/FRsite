    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { TestQuestion, TestResult, ProgramType, RoomType, TeamMember, FAQItem, ReviewItem } from \'./types\';\n\nexport const TEST_QUESTIONS: TestQuestion[] = [\n  // Addiction questions (for yourself)\n  {\n    id: 1,\n    text: \"\320\232\320\260\320\272 \321\207\320\260\321\201\321\202\320\276 \320\262\321\213 \321\203\320\277\320\276\321\202\321\200\320\265\320\261\320\273\321\217\320\265\321\202\320\265 \320\277\321\201\320\270\321\205\320\276\320\260\320\272\321\202\320\270\320\262\320\275\321\213\320\265 \320\262\320\265\321\211\320\265\321\201\321\202\320\262\320\260 \320\270\320\273\320\270 \320\260\320\273\320\272\320\276\320\263\320\276\320\273\321\214, \321\207\321\202\320\276\320\261\321\213 \321\201\320\275\321\217\321\202\321\214 \321\201\321\202\321\200\320\265\321\201\321\201, \321\203\321\201\321\202\320\260\320\273\320\276\321\201\321\202\321\214 \320\270\320\273\320\270 \321\202\321\200\320\265\320\262\320\276\320\263\321\203?\",\n    type: \"addiction\",\n    answers: [\n      { text: \"\320\235\320\270\320\272\320\276\320\263\320\264\320\260 \320\270\320\273\320\270 \320\276\321\207\320\265\320\275\321\214 \321\200\320\265\320\264\320\272\320\276\", score: 0 },\n      { text: \"\320\230\320\275\320\276\320\263\320\264\320\260, \320\262 \320\272\320\276\320\275\321\206\320\265 \321\201\320\273\320\276\320\266\320\275\320\276\320\271 \320\275\320\265\320\264\320\265\320\273\320\270\", score: 1 },\n      { text: \"\320\240\320\265\320\263\321\203\320\273\321\217\321\200\320\275\320\276, \320\275\320\265\321\201\320\272\320\276\320\273\321\214\320\272\320\276 \321\200\320\260\320\267 \320\262 \320\275\320\265\320\264\320\265\320\273\321\216\", score: 2 },\n      { text: \"\320\237\321\200\320\260\320\272\321\202\320\270\321\207\320\265\321\201\320\272\320\270 \320\272\320\260\320\266\320\264\321\213\320\271 \320\264\320\265\320\275\321\214, \320\261\320\265\320\267 \321\215\321\202\320\276\320\263\320\276 \321\202\321\200\321\203\320\264\320\275\320\276 \321\200\320\260\321\201\321\201\320\273\320\260\320\261\320\270\321\202\321\214\321\201\321\217\", score: 3 }\n    ]\n  },\n  {\n    id: 2,\n    text: \"\320\241\320\273\321\203\321\207\320\260\320\273\320\276\321\201\321\214 \320\273\320\270 \320\262\320\260\320\274 \320\264\320\260\320\262\320\260\321\202\321\214 \320\276\320\261\320\265\321\211\320\260\320\275\320\270\320\265 \321\201\320\265\320\261\320\265 \320\270\320\273\320\270 \320\261\320\273\320\270\320\267\320\272\320\270\320\274 \321\201\320\276\320\272\321\200\320\260\321\202\320\270\321\202\321\214 \321\203\320\277\320\276\321\202\321\200\320\265\320\261\320\273\320\265\320\275\320\270\320\265, \320\275\320\276 \320\277\320\276\320\267\320\266\320\265 \320\275\320\260\321\200\321\203\321\210\320\260\321\202\321\214 \320\265\320\263\320\276?\",\n    type: \"addiction\",\n    answers: [\n      { text: \"\320\235\320\265\321\202, \321\217 \320\262\321\201\320\265\320\263\320\264\320\260 \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\270\321\200\321\203\321\216 \321\201\320\262\320\276\320\270 \321\200\320\265\321\210\320\265\320\275\320\270\321\217\", score: 0 },\n      { text: \"\320\221\321\213\320\273\320\276 \320\277\320\260\321\200\321\203 \321\200\320\260\320\267, \320\275\320\276 \320\275\320\265 \321\201\321\207\320\270\321\202\320\260\321\216 \321\215\321\202\320\276 \321\201\320\270\321\201\321\202\320\265\320\274\320\276\320\271\", score: 1 },\n      { text: \"\320\224\320\260, \321\202\320\260\320\272\320\276\320\265 \321\201\320\273\321\203\321\207\320\260\320\265\321\202\321\201\321\217 \321\200\320\265\320\263\321\203\320\273\321\217\321\200\320\275\320\276, \320\275\320\265\321\201\320\274\320\276\321\202\321\200\321\217 \320\275\320\260 \320\266\320\265\320\273\320\260\320\275\320\270\320\265 \320\276\321\201\321\202\320\260\320\275\320\276\320\262\320\270\321\202\321\214\321\201\321\217\", score: 3 }\n    ]\n  },\n  {\n    id: 3,\n    text: \"\320\241\321\202\320\260\320\273\320\272\320\270\320\262\320\260\320\265\321\202\320\265\321\201\321\214 \320\273\320\270 \320\262\321\213 \321\201 \321\207\321\203\320\262\321\201\321\202\320\262\320\276\320\274 \320\262\320\270\320\275\321\213, \321\201\321\202\321\213\320\264\320\260 \320\270\320\273\320\270 \321\201\320\276\320\266\320\260\320\273\320\265\320\275\320\270\321\217 \320\277\320\276\321\201\320\273\320\265 \321\203\320\277\320\276\321\202\321\200\320\265\320\261\320\273\320\265\320\275\320\270\321\217?\",\n    type: \"addiction\",\n    answers: [\n      { text: \"\320\235\320\265\321\202, \321\202\320\260\320\272\320\276\320\263\320\276 \321\207\321\203\320\262\321\201\321\202\320\262\320\260 \320\275\320\265 \320\262\320\276\320\267\320\275\320\270\320\272\320\260\320\265\321\202\", score: 0 },\n      { text: \"\320\230\320\275\320\276\320\263\320\264\320\260 \320\261\321\213\320\262\320\260\320\265\321\202 \320\273\320\265\320\263\320\272\320\270\320\271 \320\264\320\270\321\201\320\272\320\276\320\274\321\204\320\276\321\200\321\202\", score: 1 },\n      { text: \"\320\224\320\260, \320\277\320\276\321\201\321\202\320\276\321\217\320\275\320\275\320\276 \320\270\321\201\320\277\321\213\321\202\321\213\320\262\320\260\321\216 \321\201\320\270\320\273\321\214\320\275\320\276\320\265 \321\200\320\260\321\201\320\272\320\260\321\217\320\275\320\270\320\265 \320\270 \321\201\321\202\321\213\320\264 \320\277\320\265\321\200\320\265\320\264 \320\261\320\273\320\270\320\267\320\272\320\270\320\274\320\270\", score: 3 }\n    ]\n  },\n  {\n    id: 4,\n    text: \"\320\227\320\260\320\274\320\265\321\207\320\260\320\265\321\202\320\265 \320\273\320\270 \320\262\321\213, \321\207\321\202\320\276 \320\264\320\273\321\217 \320\264\320\276\321\201\321\202\320\270\320\266\320\265\320\275\320\270\321\217 \320\277\321\200\320\265\320\266\320\275\320\265\320\263\320\276 \321\215\321\204\321\204\320\265\320\272\321\202\320\260 \321\200\320\260\321\201\321\201\320\273\320\260\320\261\320\273\320\265\320\275\320\270\321\217 \320\262\320\260\320\274 \321\202\321\200\320\265\320\261\321\203\320\265\321\202\321\201\321\217 \320\262\321\201\321\221 \320\261\320\276\320\273\321\214\321\210\320\260\321\217 \320\264\320\276\320\267\320\260?\",\n    type: \"addiction\",\n    answers: [\n      { text: \"\320\235\320\265\321\202, \320\264\320\276\320\267\320\260 \320\275\320\265 \320\274\320\265\320\275\321\217\320\265\321\202\321\201\321\217\", score: 0 },\n      { text: \"\320\222\320\276\320\267\320\274\320\276\320\266\320\275\320\276, \320\275\320\265\320\267\320\275\320\260\321\207\320\270\321\202\320\265\320\273\321\214\320\275\320\276 \320\261\320\276\320\273\321\214\321\210\320\265, \321\207\320\265\320\274 \321\200\320\260\320\275\321\214\321\210\320\265\", score: 1 },\n      { text: \"\320\224\320\260, \321\202\320\276\320\273\320\265\321\200\320\260\320\275\321\202\320\275\320\276\321\201\321\202\321\214 \320\267\320\260\320\274\320\265\321\202\320\275\320\276 \320\262\321\213\321\200\320\276\321\201\320\273\320\260, \321\202\321\200\320\265\320\261\321\203\320\265\321\202\321\201\321\217 \320\263\320\276\321\200\320\260\320\267\320\264\320\276 \320\261\320\276\320\273\321\214\321\210\320\265\", score: 3 }\n    ]\n  },\n  {\n    id: 5,\n    text: \"\320\237\320\276\320\262\320\273\320\270\321\217\320\273\320\276 \320\273\320\270 \320\262\320\260\321\210\320\265 \321\203\320\262\320\273\320\265\321\207\320\265\320\275\320\270\320\265/\320\277\321\200\320\270\320\262\321\213\321\207\320\272\320\260 \320\275\320\260 \321\200\320\260\320\261\320\276\321\202\321\203, \321\203\321\207\320\265\320\261\321\203, \321\204\320\270\320\275\320\260\320\275\321\201\320\276\320\262\320\276\320\265 \320\277\320\276\320\273\320\276\320\266\320\265\320\275\320\270\320\265 \320\270\320\273\320\270 \320\276\321\202\320\275\320\276\321\210\320\265\320\275\320\270\321\217 \321\201 \320\261\320\273\320\270\320\267\320\272\320\270\320\274\320\270?\",\n    type: \"addiction\",\n    answers: [\n      { text: \"\320\235\320\270\320\272\320\260\320\272 \320\275\320\265 \320\277\320\276\320\262\320\273\320\270\321\217\320\273\320\276, \320\262\321\201\321\221 \320\262 \320\277\320\276\320\273\320\275\320\276\320\274 \320\277\320\276\321\200\321\217\320\264\320\272\320\265\", score: 0 },\n      { text: \"\320\225\321\201\321\202\321\214 \320\274\320\265\320\273\320\272\320\270\320\265 \321\200\320\260\320\267\320\275\320\276\320\263\320\273\320\260\321\201\320\270\321\217, \320\275\320\276 \320\262 \321\206\320\265\320\273\320\276\320\274 \320\262\321\201\321\221 \321\201\321\202\320\260\320\261\320\270\320\273\321\214\320\275\320\276\", score: 1 },\n      { text: \"\320\224\320\260, \320\275\320\260\321\207\320\260\320\273\320\270\321\201\321\214 \321\201\320\265\321\200\321\214\320\265\320\267\320\275\321\213\320\265 \320\277\321\200\320\276\320\261\320\273\320\265\320\274\321\213 \320\262 \321\201\320\265\320\274\321\214\320\265, \320\264\320\276\320\273\320\263\320\270 \320\270\320\273\320\270 \321\202\321\200\321\203\320\264\320\275\320\276\321\201\321\202\320\270 \320\275\320\260 \321\200\320\260\320\261\320\276\321\202\320\265\", score: 3 }\n    ]\n  },\n\n  // Codependency questions (for family members)\n  {\n    id: 101,\n    text: \"\320\247\321\203\320\262\321\201\321\202\320\262\321\203\320\265\321\202\320\265 \320\273\320\270 \320\262\321\213 \320\277\320\276\321\201\321\202\320\276\321\217\320\275\320\275\321\203\321\216 \321\202\321\200\320\265\320\262\320\276\320\263\321\203, \320\272\320\276\320\275\321\202\321\200\320\276\320\273\320\270\321\200\321\203\321\217 \320\272\320\260\320\266\320\264\321\213\320\271 \321\210\320\260\320\263 \320\262\320\260\321\210\320\265\320\263\320\276 \320\261\320\273\320\270\320\267\320\272\320\276\320\263\320\276 (\320\263\320\264\320\265 \320\276\320\275, \321\201 \320\272\320\265\320\274, \321\202\321\200\320\265\320\267\320\262 \320\273\320\270)?\",\n    type: \"codependency\",\n    answers: [\n      { text: \"\320\235\320\265\321\202, \321\217 \320\264\320\276\320\262\320\265\321\200\321\217\321\216 \320\270 \320\267\320\260\320\275\320\270\320\274\320\260\321\216\321\201\321\214 \321\201\320\262\320\276\320\265\320\271 \320\266\320\270\320\267\320\275\321\214\321\216\", score: 0 },\n      { text: \"\320\230\320\275\320\276\320\263\320\264\320\260 \321\202\321\200\320\265\320\262\320\276\320\266\321\203\321\201\321\214, \320\275\320\276 \320\274\320\276\320\263\321\203 \320\277\320\265\321\200\320\265\320\272\320\273\321\216\321\207\320\270\321\202\321\214\321\201\321\217\", score: 1 },\n      { text: \"\320\224\320\260, \321\217 \320\275\320\260\321\205\320\276\320\266\321\203\321\201\321\214 \320\262 \320\277\320\276\321\201\321\202\320\276\321\217\320\275\320\275\320\276\320\274 \320\275\320\260\320\277\321\200\321\217\320\266\320\265\320\275\320\270\320\270, \320\277\321\200\320\276\320\262\320\265\321\200\321\217\321\216 \321\202\320\265\320\273\320\265\321\204\320\276\320\275, \320\272\320\260\321\200\320\274\320\260\320\275\321\213, \320\267\320\262\320\276\320\275\321\216 \320\277\320\276 \320\274\320\275\320\276\320\263\320\276 \321\200\320\260\320\267\", score: 3 }\n    ]\n  },\n  {\n    id: 102,\n    text: \"\320\240\320\265\321\210\320\260\320\265\321\202\320\265 \320\273\320\270 \320\262\321\213 \321\204\320\270\320\275\320\260\320\275\321\201\320\276\320\262\321\213\320\265 \320\277\321\200\320\276\320\261\320\273\320\265\320\274\321\213 \320\261\320\273\320\270\320\267\320\272\320\276\320\263\320\276 (\320\262\321\213\320\277\320\273\320\260\321\207\320\270\320\262\320\260\320\265\321\202\320\265 \320\264\320\276\320\273\320\263\320\270, \320\272\321\200\320\265\320\264\320\270\321\202\321\213, \320\264\320\260\320\265\321\202\320\265 \320\264\320\265\320\275\321\214\320\263\320\270 \320\275\320\260 \'\320\277\320\276\321\201\320\273\320\265\320\264\320\275\320\270\320\271 \321\200\320\260\320\267\')?\",\