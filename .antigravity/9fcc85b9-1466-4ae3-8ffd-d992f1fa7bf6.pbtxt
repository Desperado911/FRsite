          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                \320\227\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\321\214 \320\275\320\270\320\272\320\276\320\263\320\264\320\260 \320\275\320\265 \321\200\320\260\320\267\320\262\320\270\320\262\320\260\320\265\321\202\321\201\321\217 \320\262 \320\262\320\260\320\272\321\203\321\203\320\274\320\265. \320\255\321\202\320\276 <strong>\321\201\320\265\320\274\320\265\320\271\320\275\320\260\321\217 \320\261\320\276\320\273\320\265\320\267\320\275\321\214</strong>. \320\232\320\276\320\263\320\264\320\260 \320\276\320\264\320\270\320\275 \320\270\320\267 \321\207\320\273\320\265\320\275\320\276\320\262 \321\201\320\265\320\274\321\214\320\270 \321\201\321\202\321\200\320\260\320\264\320\260\320\265\321\202 \320\260\320\273\320\272\320\276\320\263\320\276\320\273\320\270\320\267\320\274\320\276\320\274, \320\275\320\260\321\200\320\272\320\276\320\274\320\260\320\275\320\270\320\265\320\271 \320\270\320\273\320\270 \320\270\320\263\321\200\320\276\320\274\320\260\320\275\320\270\320\265\320\271, \320\262\321\201\320\265 \321\200\320\276\320\264\321\201\321\202\320\262\320\265\320\275\320\275\320\270\320\272\320\270 \320\262\320\276\320\262\320\273\320\265\320\272\320\260\321\216\321\202\321\201\321\217 \320\262 \320\264\320\265\321\201\321\202\321\200\321\203\320\272\321\202\320\270\320\262\320\275\321\203\321\216 \321\201\320\270\321\201\321\202\320\265\320\274\321\203 \321\201\320\276\320\267\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\320\270. "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
