        lines {
          text: "    answer: \"\320\234\320\270\320\275\320\270\320\274\320\260\320\273\321\214\320\275\321\213\320\271 \320\272\321\203\321\200\321\201 \320\264\320\265\321\202\320\276\320\272\321\201\320\260 \320\264\320\273\320\270\321\202\321\201\321\217 5\342\200\22310 \320\264\320\275\320\265\320\271. \320\221\320\260\320\267\320\276\320\262\321\213\320\271 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\320\270\320\271 \320\272\321\203\321\200\321\201 \342\200\224 28 \320\264\320\275\320\265\320\271. \320\236\320\264\320\275\320\260\320\272\320\276 \320\264\320\273\321\217 \320\277\320\276\320\273\320\275\320\276\320\263\320\276 \321\200\320\260\320\267\321\200\321\203\321\210\320\265\320\275\320\270\321\217 \320\275\320\265\320\271\321\200\320\276\320\275\320\275\321\213\321\205 \321\201\320\262\321\217\320\267\320\265\320\271 \320\267\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\320\270 \320\270 \321\204\320\276\321\200\320\274\320\270\321\200\320\276\320\262\320\260\320\275\320\270\321\217 \321\203\321\201\321\202\320\276\320\271\321\207\320\270\320\262\321\213\321\205 \320\275\320\260\320\262\321\213\320\272\320\276\320\262 \321\202\321\200\320\265\320\267\320\262\320\276\320\271 \320\266\320\270\320\267\320\275\320\270 \320\274\321\213 \321\200\320\265\320\272\320\276\320\274\320\265\320\275\320\264\321\203\320\265\320\274 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\201\320\275\321\213\320\265 \320\277\321\200\320\276\320\263\321\200\320\260\320\274\320\274\321\213 \320\275\320\260 3 \320\270\320\273\320\270 6 \320\274\320\265\321\201\321\217\321\206\320\265\320\262. \320\224\320\273\320\270\321\202\320\265\320\273\321\214\320\275\320\276\321\201\321\202\321\214 \320\277\320\276\320\264\320\261\320\270\321\200\320\260\320\265\321\202\321\201\321\217 \320\272\320\276\320\275\321\201\320\270\320\273\320\270\321\203\320\274\320\276\320\274 \320\262\321\200\3