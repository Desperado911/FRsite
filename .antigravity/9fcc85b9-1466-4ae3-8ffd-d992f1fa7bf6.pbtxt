      replacement_content: "      {/* Our Professional Team Grid */}\n      <section id=\"team\" className=\"py-24 bg-bg-secondary border-t border-border-custom\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-16\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-accent-light text-accent text-xs font-semibold uppercase tracking-wider border border-border-custom mb-3\">\n              <Users className=\"w-4 h-4\" /> \320\235\320\260\321\210\320\260 \320\272\320\276\320\274\320\260\320\275\320\264\320\260\n            </span>\n            <h2 className=\"text-3xl md:text-4xl font-serif font-semibold tracking-tight text-text-primary mb-4\">\n              \320\224\320\270\320\277\320\273\320\276\320\274\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\265 \320\262\321\200\320\260\321\207\320\270 \320\270 \320\277\321\201\320\270\321\205\320\276\321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202\321\213\n            </h2>\n            <p className=\"text-text-primary/75 max-w-xl mx-auto text-sm md:text-base leading-relaxed\">\n              \320\234\321\213 \320\263\320\276\321\200\320\264\320\270\320\274\321\201\321\217 \320\275\320\260\321\210\320\265\320\271 \320\272\320\276\320\274\320\260\320\275\320\264\320\276\320\271. \320\232\320\260\320\266\320\264\321\213\320\271 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\321\201\321\202 \342\200\224 \321\215\321\202\320\276 \320\277\321\200\320\270\320\267\320\275\320\260\320\275\320\275\321\213\320\271 \320\277\321\200\320\276\321\204\320\265\321\201\321\201\320\270\320\276\320\275\320\260\320\273 \321\201 \320\274\320\275\320\276\320\263\320\276\320\273\320\265\321\202\320\275\320\270\320\274 \320\276\320\277\321\213\321\202\320\276\320\274 \320\277\321\200\320\260\320\272\321\202\320\270\321\207\320\265\321\201\320\272\320\276\320\271 \321\200\320\260\320\261\320\276\321\202