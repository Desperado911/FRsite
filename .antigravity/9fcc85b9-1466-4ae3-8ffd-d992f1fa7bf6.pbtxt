          text: "    question: \"\320\234\320\276\320\266\320\275\320\276 \320\273\320\270 \320\275\320\260\320\262\320\265\321\211\320\260\321\202\321\214 \321\200\320\265\320\267\320\270\320\264\320\265\320\275\321\202\320\260 \320\262\320\276 \320\262\321\200\320\265\320\274\321\217 \320\273\320\265\321\207\320\265\320\275\320\270\321\217?\","
