265\320\273\320\265\320\275\320\270\320\265 \320\276\321\202 \321\207\321\203\320\262\321\201\321\202\320\262\320\260 \320\262\320\270\320\275\321\213</h4>\n                    <p className=\"text-stone-400 text-xs leading-normal mt-0.5\">\320\237\320\276\320\274\320\276\320\263\320\260\320\265\320\274 \320\274\320\260\321\202\320\265\321\200\321\217\320\274 \320\270 \321\201\321\203\320\277\321\200\321\203\320\263\320\260\320\274 \320\270\320\267\320\261\320\260\320\262\320\270\321\202\321\214\321\201\321\217 \320\276\321\202 \320\263\320\270\320\277\320\265\321\200\320\276\320\277\320\265\320\272\320\270, \320\275\320\260\321\203\321\207\320\270\321\202\321\214\321\201\321\217 \321\201\321\202\320\260\320\262\320\270\321\202\321\214 \320\263\321\200\320\260\320\275\320\270\321\206\321\213 \320\270 \321\201\320\275\320\276\320\262\320\260 \320\266\320\270\321\202\321\214 \321\201\320\262\320\276\320\265\320\271 \320\266\320\270\320\267\320\275\321\214\321\216.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/10\">\n                    \342\234\223\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-xs md:text-sm text-white\">\320\240\320\260\320\267\321\200\321\203\321\210\320\265\320\275\320\270\320\265 \321\201\321\202\320\260\321\200\321\213\321\205 \321\202\321\200\320\270\320\263\320\263\320\265\321\200\320\276\320\262</h4>\n                    <p className=\"text-stone-400 text-xs leading-normal mt-0.5\">\320\243\321\207\320\270\320\274 \321\201\320\265\320\274\321\214\321\216 \320\272\320\276\320\274\320\274\321\203\320\275\320\270\321\206\320\270\321\200\320\276\320\262\320\260\321\202\321\214 \320\261\320\265\320\267 \320\276\320\261\320\270\320\264, \320\277\321\200\320\265\321\202\320\265\320\275\320\267\320\270\320\271 \320\270 \320\274\320\260\320\275\320\270\320\277\321\203\320\273\321\217\321\206\320\270\320\271 \342\200\224 \320\263\320\273\320\260\320\262\320\275\320\276\320\263\320\276 \321\202\320\276\320\277\320\273\320\270\320\262\320\260 \320\264\320\273\321\217 \320\261\321\203\320\264\321\203\321\211\320\270\321\205 \321\201\321\200\321\213\320\262\320\276\320\262.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/10\">\n                    \342\234\223\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-xs md:text-sm text-white\">\320\221\320\265\321\200\320\265\320\266\320\275\320\260\321\217 \321\201\320\276\321\206\320\270\320\260\320\273\320\270\320\267\320\260\321\206\320\270\321\217</h4>\n                    <p className=\"text-stone-400 text-xs leading-normal mt-0.5\">\320\237\320\276\321\201\320\273\320\265 \320\262\321\213\320\277\320\270\321\201\320\272\320\270 \320\274\321\213 \321\201\320\276\320\277\321\200\320\276\320\262\320\276\320\266\320\264\320\260\320\265\320\274 \321\201\320\265\320\274\321\214\321\216 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 1 \320\263\320\276\320\264\320\260 \342\200\224 \320\264\320\260\320\265\320\274 \320\261\320\265\321\200\320\265\320\266\320\275\321\203\321\216 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\321\203\321\216 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\321\203.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"pt-4\">\n                <button\n                  id=\"about-action\"\n                  onClick={() => openConsultation(\'\320\227\320\260\320\277\321\200\320\276\321\201 \320\275\320\260 \320\272\320\276\320\275\321\201\321\203\320\273\321\214\321\202\320\260\321\206\320\270\321\216 \320\277\320\276 \321\201\320\265\320\274\320\265\320\271\320\275\320\276\320\274\321\203 \320\277\320\276\320\264\321\205\320\276\320\264\321\203\')}\n                  className=\"bg-stone-900 hover:bg-stone-850 text-stone-200 border border-stone-800 hover:border-stone-700 font-bold py-3.5 px-6 rounded-xl transition-all cursor-pointer text-xs md:text-sm\"\n                >\n                  \320\243\320\267\320\275\320\260\321\202\321\214 \320\261\320\276\320\273\321\214\321\210\320\265 \320\276 \321\201\320\265\320\274\320\265\320\271\320\275\320\276\320\271 \320\277\321\200\320\276\320\263\321\200\320\260\320\274\320\274\320\265\n                </button>\n              </div>\n\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* Program Directions Quick Preview */}\n      <section id=\"programs\" className=\"py-24 bg-stone-900/50 border-t border-stone-900\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-16\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3\">\n              <Award className=\"w-4 h-4\" /> \320\235\320\260\321\210\320\270 \320\275\320\260\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\321\217\n            </span>\n            <h2 className=\"text-3xl md:text-4xl font-sans font-bold tracking-tight text-white mb-4\">\n              \320\237\321\200\320\276\320\263\321\200\320\260\320\274\320\274\321\213 \320\272\320\276\320\274\320\277\320\273\320\265\320\272\321\201\320\275\320\276\320\263\320\276 \320\262\321\213\320\267\320\264\320\276\321\200\320\276\320\262\320\273\320\265\320\275\320\270\321\217\n            </h2>\n            <p className=\"text-stone-400 max-w-xl mx-auto text-sm md:text-base leading-relaxed\">\n              \320\234\321\213 \321\200\320\260\320\267\321\200\320\260\320\261\320\276\321\202\320\260\320\273\320\270 \321\215\321\204\321\204\320\265\320\272\321\202\320\270\320\262\320\275\321\213\320\265 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\320\267\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\265 \320\272\321\203\321\200\321\201\321\213 \320\273\320\265\321\207\320\265\320\275\320\270\321\217 \320\264\320\273\321\217 \320\272\320\260\320\266\320\264\320\276\320\263\320\276 \321\202\320\270\320\277\320\260 \320\260\320\264\320\264\320\270\320\272\321\206\320\270\320\270. \320\222\321\213\320\261\320\265\321\200\320\270\321\202\320\265 \320\275\321\203\320\266\320\275\320\276\320\265 \320\275\320\260\320\277\321\200\320\260\320\262\320\273\320\265\320\275\320\270\320\265.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {PROGRAMS.map((prog) => (\n              <div \n                key={prog.id} \n                className=\"bg-stone-950 border border-stone-850 rounded-2xl p-6 flex flex-col justify-between hover:border-emerald-500/30 transition-all group\"\n              >\n                <div>\n                  <div className=\"w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-sm mb-4 border border-emerald-500/20 group-hover:bg-emerald-600 group-hover:text-white transition-colors\">\n                    {prog.id === \'detox\' && \'\342\232\225\'}\n                    {prog.id === \'classic\' && \'\342\234\246\'}\n                    {prog.id === \'comprehensive\' && \'\342\227\210\'}\n                    {prog.id === \'family\' && \'\342\231\245\'}\n                  </div>\n                  <h3 className=\"text-base md:text-lg font-bold text-white mb-2 leading-tight group-hover:text-emerald-400 transition-colors\">\n                    {prog.name}\n                  </h3>\n                  <p className=\"text-stone-400 text-xs leading-relaxed mb-6\">\n                    {prog.description}\n                  </p>\n                </div>\n                <div>\n                  <button\n                    onClick={(e) => {\n                      // Custom function to scroll to calculator and preselect program\n                      const el = document.querySelector(\'#calculator\');\n                      if (el) {\n                        const offset = 80;\n                        const bodyRect = document.body.getBoundingClientRect().top;\n                        const elementRect = el.getBoundingClientRect().top;\n                        const elementPosition = elementRect - bodyRect;\n                        const offsetPosition = elementPosition - offset;\n                        window.scrollTo({ top: offsetPosition, behavior: \'smooth\' });\n                        // Preselect the program in the calculator\n                        const event = new CustomEvent(\'preselectProgram\', { detail: prog.id });\n                        window.dispatchEvent(event);\n                      }\n                    }}\n                    className=\"w-full bg-stone-900 hover:bg-emerald-600 text-stone-300 hover:text-white text-xs font-semibold py-2.5 rounded-xl transition-all flex items-center justify-center gap-1.5 group/btn cursor-pointer\"\n                  >\n                    <span>\320\240\320\260\321\201\321\201\321\207\320\270\321\202\320\260\321\202\321\214 \321\201\321\202\320\276\320\270\320\274\320\276\321\201\321\202\321\214</span>\n                    <ChevronRight className=\"w-4 h-4 group-hover/btn:translate-x-1 transition-transform\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* Motivation Guide Widget */}\n      <MotivationGuide onOpenConsultation={openConsultation} />\n\n      {/* Dynamic Calculator Section */}\n      <CalculatorSection onOpenConsultation={openConsultation} />\n\n      {/* Self-Test Section */}\n      <TestSection onOpenConsultation={openConsultation} />\n\n      {/* Our Professional Team Grid */}\n      <section id=\"team\" className=\"py-24 bg-stone-900 border-t border-stone-800\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-16\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3\">\n              <Users className=\"w-4 h-4\" /> \320\235\320\260\321\210\320\260 \320\272\320\276\320\274\320\260\320\275\320\264\320\260\n            </span>\n            <h2 className=\"text-3xl md:text-4xl font-sans font-bold tracking-tight text-white mb-4\">\n              \320\224\320\270\320\277\320\273\320\276\320\274\320\270\321\200\320\276\320\262\320\260\320\275\320\275\321\213\320\265 \320\262\321\200\320\260\321\207\320\270 \320\270 \320\277\321\201\320\270\321\205\320\276\321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202\321\213\n            </h2>\n            <p className=\"text-stone-400 max-w-xl mx-auto text-sm md:text-base leading-relaxed\">\n              \320\234\321\213 \320\263\320\276\321\200\320\264\320\270\320\274\321\201\321\217 \320\275\320\260\321\210\320\265\320\271 \320\272\320\276\320\274\320\260\320\275\320\264\320\276\320\271. \320\232\320\260\320\266\320\264\321\213\320\271 \321\201\320\277\320\265\321\206\320\270\320\260\320\273\320\270\321\201\321\202 \342\200\224 \321\215\321\202\320\276 \320\277\321\200\320\270\320\267\320\275\320\260\320\275\320\275\321\213\320\271 \320\277\321\200\320\276\321\204\320\265\321\201\321\201\320\270\320\276\320\275\320\260\320\273 \321\201 \320\274\320\275\320\276\320\263\320\276\320\273\320\265\321\202\320\275\320\270\320\274 \320\276\320\277\321\213\321\202\320\276\320\274 \320\277\321\200\320\260\320\272\321\202\320\270\321\207\320\265\321\201\320\272\320\276\320\271 \321\200\320\260\320\261\320\276\321\202\321\213 \320\262 \321\201\321\204\320\265\321\200\320\265 \321\200\320\265\320\260\320\261\320\270\320\273\320\270\321\202\320\260\321\206\320\270\320\270.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {TEAM.map((member) => (\n              <div \n                key={member.id}\n                className=\"bg-stone-950 border border-stone-850 rounded-2xl overflow-hidden shadow-xl hover:border-emerald-500/20 transition-all flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"relative\">\n                    <img \n                      src={member.photoUrl} \n                      alt={member.name}\n                      className=\"w-full h-64 object-cover\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <div className=\"absolute inset-0 bg-gradient-to-t from-stone-950 via-transparent to-transparent opacity-80\" />\n                    <div className=\"absolute bottom-4 left-4\">\n                      <span className=\"text-[10px] text-emerald-400 font-bold uppercase tracking-wider bg-stone-950/80 backdrop-blur-sm px-2.5 py-1 rounded-md border border-stone-800\">\n                        {member.experience}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"p-5\">\n                    <h3 className=\"font-bold text-sm md:text-base text-white\">{member.name}</h3>\n                    <p className=\"text-emerald-500 text-xs font-medium mt-0.5\">{member.role}</p>\n                    <p className=\"text-stone-400 text-[11px] md:text-xs mt-3 leading-normal\">\n                      {member.specialty}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"px-5 pb-5 pt-0 border-t border-stone-900/50\">\n                  <p className=\"text-[10px] text-stone-500 leading-normal pt-3 italic\">\n                    {member.education}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"mt-12 text-center\">\n            <p className=\"text-xs text-stone-400 mb-4 font-sans max-w-md mx-auto leading-normal\">\n              \320\222\321\201\320\265 \320\262\321\200\320\260\321\207\320\270 \320\270\320\274\320\265\321\216\321\202 \320\264\320\265\320\271\321\201\321\202\320\262\321\203\321\216\321\211\320\270\320\265 \321\201\320\265\321\200\321\202\320\270\321\204\320\270\320\272\320\260\321\202\321\213 \320\234\320\270\320\275\320\267\320\264\321\200\320\260\320\262\320\260 \320\240\320\244. \320\232\320\273\320\270\320\275\320\270\320\272\320\260 FAMILY REHUB \320\273\320\270\321\206\320\265\320\275\320\267\320\270\321\200\320\276\320\262\320\260\320\275\320\260 \320\264\320\273\321\217 \320\276\321\201\321\203\321\211\320\265\321\201\321\202\320\262\320\273\320\265\320\275\320\270\321\217 \320\274\320\265\320\264\320\270\321\206\320\270\320\275\321\201\320\272\320\276\320\271 \320\270 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\320\276\320\271 \320\277\320\276\320\274\320\276\321\211\320\270.\n            </p>\n            <button\n              onClick={() => openConsultation(\'\320\227\320\260\320\277\321\200\320\276\321\201 \320\275\320\260 \320\272\320\276\320\275\321\201\321\203\320\273\321\214\321\202\320\260\321\206\320\270\321\216 \320\262\320\265\320\264\321\203\321\211\320\265\320\263\320\276 \320\277\321\201\320\270\321\205\320\276\321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202\320\260\')}\n              className=\"inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 hover:text-emerald-300 transition-colors\"\n            >\n              \320\227\320\260\320\277\320\270\321\201\320\260\321\202\321\214\321\201\321\217 \320\275\320\260 \321\201\320\265\321\201\321\201\320\270\321\216 \320\272 \320\262\320\265\320\264\321\203\321\211\320\265\320\274\321\203 \320\277\321\201\320\270\321\205\320\276\321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202\321\203 <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* Success Stories / Testimonials */}\n      <section id=\"reviews\" className=\"py-24 bg-stone-950 border-t border-stone-900\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-16\">\n            <span className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3\">\n              <HeartHandshake className=\"w-4 h-4\" /> \320\230\321\201\321\202\320\276\321\200\320\270\320\270 \320\277\320\276\320\261\320\265\320\264\n            </span>\n            <h2 className=\"text-3xl md:text-4xl font-sans font-bold tracking-tight text-white mb-4\">\n              \320\230\321\201\320\272\321\200\320\265\320\275\320\275\320\270\320\265 \320\276\321\202\320\267\321\213\320\262\321\213 \321\201\320\277\320\260\321\201\320\265\320\275\320\275\321\213\321\205 \321\201\320\265\320\274\320\265\320\271\n            </h2>\n            <p className=\"text-stone-400 max-w-xl mx-auto text-sm md:text-base leading-relaxed\">\n              \320\232\320\260\320\266\320\264\320\260\321\217 \320\270\321\201\321\202\320\276\321\200\320\270\321\217 \342\200\224 \321\215\321\202\320\276 \321\202\321\217\320\266\320\265\320\273\321\213\320\271 \320\277\321\203\321\202\321\214, \320\277\321\200\320\276\320\271\320\264\320\265\320\275\320\275\321\213\320\271 \320\262\320\274\320\265\321\201\321\202\320\265. \320\240\320\265\320\260\320\273\321\214\320\275\321\213\320\265 \320\276\321\202\320\267\321\213\320\262\321\213 \321\200\320\276\320\264\320\270\321\202\320\265\320\273\320\265\320\271, \321\201\321\203\320\277\321\200\321\203\320\263\320\276\320\262 \320\270 \321\201\320\260\320\274\320\270\321\205 \320\262\321\213\320\277\321\203\321\201\320\272\320\275\320\270\320\272\320\276\320\262 \320\276 \320\275\320\276\320\262\320\276\320\271 \321\201\321\207\320\260\321\201\321\202\320\273\320\270\320\262\320\276\320\271 \320\266\320\270\320\267\320\275\320\270.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n            {REVIEWS.map((review) => (\n              <div \n                key={review.id}\n                className=\"bg-stone-900/40 border border-stone-850 p-6 md:p-8 rounded-2xl flex flex-col justify-between shadow-lg relative\"\n              >\n                <div>\n                  {/* Sobriety period badge */}\n                  <div className=\"flex justify-between items-start mb-4\">\n                    <div>\n                      <h4 className=\"font-bold text-white text-sm md:text-base leading-snug\">{review.author}</h4>\n                      <p className=\"text-stone-400 text-xs\">{review.relation}</p>\n                    </div>\n                    <span className=\"text-[10px] text-emerald-400 font-mono font-bold bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20\">\n                      {review.recoveredPeriod}\n                    </span>\n                  </div>\n\n                  {/* Rating Stars */}\n                  <div className=\"flex gap-1 mb-4 text-amber-400\">\n                    {Array.from({ length: review.rating }).map((_, i) => (\n                      <Star key={i} className=\"w-4 h-4 fill-amber-400\" />\n                    ))}\n                  </div>\n\n                  <p className=\"text-stone-300 text-xs md:text-sm leading-relaxed italic mb-6\">\n                    \302\253{review.text}\302\273\n                  </p>\n                </div>\n\n                <div className=\"text-[11px] text-stone-500 font-mono text-right border-t border-stone-850/30 pt-4\">\n                  \320\236\320\277\321\203\320\261\320\273\320\270\320\272\320\276\320\262\320\260\320\275\320\276: {review.date}\n                </div>\n              </div>\n            ))}\n          </div>\n\n          <div className=\"mt-12 bg-stone-900 border border-stone-800 p-6 rounded-2xl max-w-2xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left\">\n            <div>\n              <h4 className=\"font-bold text-white text-sm md:text-base\">\320\222\320\260\321\210\320\260 \321\201\320\265\320\274\321\214\321\217 \321\202\320\276\320\266\320\265 \320\274\320\276\320\266\320\265\321\202 \320\262\320\265\321\200\320\275\321\203\321\202\321\214\321\201\321\217 \320\272 \320\267\320\264\320\276\321\200\320\276\320\262\320\276\320\271 \320\266\320\270\320\267\320\275\320\270</h4>\n              <p className=\"text-xs text-stone-400 mt-1 leading-normal\">\320\237\320\265\321\200\320\262\321\213\320\271 \321\210\320\260\320\263 \342\200\224 \321\201\320\260\320\274\321\213\320\271 \321\202\321\200\321\203\320\264\320\275\321\213\320\271, \320\275\320\276 \320\274\321\213 \320\277\321\200\320\276\320\271\320\264\320\265\320\274 \320\265\320\263\320\276 \320\262\320\274\320\265\321\201\321\202\320\265.</p>\n            </div>\n            <button\n              onClick={() => openConsultation(\'\320\227\320\260\321\217\320\262\320\272\320\260 \320\277\320\276 \320\272\320\275\320\276\320\277\320\272\320\265 \"\320\245\320\276\321\207\321\203 \320\262\320\276\321\201\321\201\321\202\320\260\320\275\320\276\320\262\320\270\321\202\321\214 \321\201\320\265\320\274\321\214\321\216\" \320\277\320\276\320\264 \320\276\321\202\320\267\321\213\320\262\320\260\320\274\320\270\')}\n              className=\"bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold py-3 px-5 rounded-xl transition-colors cursor-pointer shrink-0\"\n            >\n              \320\245\320\276\321\207\321\203 \320\262\320\276\321\201\321\201\321\202\320\260\320\275\320\276\320\262\320\270\321\202\321\214 \321\201\320\265\320\274\321\214\321\216\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* FAQ Section */}\n      <FAQSection />\n\n      {/* Emergency Bottom Call-To-Action Banner */}\n      <section className=\"py-20 bg-gradient-to-t from-stone-950 to-stone-900 relative overflow-hidden border-t border-stone-850\">\n        <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_bottom,rgba(16,185,129,0.05),transparent_50%)] pointer-events-none\" />\n        \n        <div className=\"max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center\">\n          <span className=\"relative flex h-3 w-3 mx-auto mb-4\">\n            <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75\"></span>\n            <span className=\"relative inline-flex rounded-full h-3 w-3 bg-red-500\"></span>\n          </span>\n          <h2 className=\"text-2xl sm:text-3xl md:text-4xl font-sans font-black text-white tracking-tight mb-4 leading-tight\">\n            \320\223\320\276\321\200\321\217\321\207\320\260\321\217 \320\273\320\270\320\275\320\270\321\217 \321\215\320\272\321\201\321\202\321\200\320\265\320\275\320\275\320\276\320\271 \320\277\320\276\320\274\320\276\321\211\320\270 \321\200\320\260\320\261\320\276\321\202\320\260\320\265\321\202 24/7\n          </h2>\n          <p className=\"text-stone-300 text-sm md:text-base max-w-xl mx-auto mb-8 leading-relaxed\">\n            \320\225\321\201\320\273\320\270 \320\262\320\260\321\210\320\265\320\274\321\203 \320\261\320\273\320\270\320\267\320\272\320\276\320\274\321\203 \320\277\320\273\320\276\321\205\320\276 \320\277\321\200\321\217\320\274\320\276 \321\201\320\265\320\271\321\207\320\260\321\201, \320\270\320\273\320\270 \321\202\321\200\320\265\320\261\321\203\320\265\321\202\321\201\321\217 \321\201\321\200\320\276\321\207\320\275\321\213\320\271 \320\262\321\213\320\265\320\267\320\264 \320\275\320\260\321\200\320\272\320\276\320\273\320\276\320\263\320\260 / \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\320\276\320\271 \320\277\320\276\320\274\320\276\321\211\320\270 \320\275\320\260 \320\264\320\276\320\274 \342\200\224 \320\275\320\265 \321\202\320\265\321\200\321\217\320\271\321\202\320\265 \320\262\321\200\320\265\320\274\321\217. \320\227\320\262\320\276\320\275\320\276\320\272 \320\277\320\276\320\273\320\275\320\276\321\201\321\202\321\214\321\216 \320\260\320\275\320\276\320\275\320\270\320\274\320\265\320\275.\n          </p>\n\n          <div className=\"flex flex-col sm:flex-row justify-center items-center gap-4\">\n            <a\n              href=\"tel:88005553942\"\n              className=\"w-full sm:w-auto bg-red-600 hover:bg-red-500 text-white font-black py-4.5 px-8 rounded-xl transition-all hover:scale-102 flex items-center justify-center gap-2 shadow-lg shadow-red-900/20 text-base md:text-lg\"\n            >\n              <PhoneCall className=\"w-5 h-5 animate-pulse\" /> 8 (800) 555-39-42\n            </a>\n            <button\n              onClick={() => openConsultation(\'\320\227\320\260\321\217\320\262\320\272\320\260 \320\275\320\260 \321\201\321\200\320\276\321\207\320\275\321\213\320\271 \320\262\321\213\320\265\320\267\320\264 \320\277\320\276\320\274\320\276\321\211\320\270 24/7 \321\201 \321\204\321\203\321\202\320\265\321\200\320\260\')}\n              className=\"w-full sm:w-auto bg-stone-900 hover:bg-stone-850 border border-stone-800 hover:border-stone-700 text-stone-200 font-bold py-4 px-6 rounded-xl transition-all cursor-pointer text-sm\"\n            >\n              \320\237\320\265\321\200\320\265\320\267\320\262\320\276\320\275\320\270\321\202\320\265 \320\274\320\275\320\265 \320\260\320\275\320\276\320\275\320\270\320\274\320\275\320\276\n            </button>\n          </div>\n\n          <div className=\"mt-8 flex justify-center items-center gap-6 text-[11px] text-stone-500 font-mono\">\n            <span>\342\234\223 \320\221\320\265\320\267 \320\277\320\260\321\201\320\277\320\276\321\200\321\202\320\260 \320\270 \320\264\320\276\320\272\321\203\320\274\320\265\320\275\321\202\320\276\320\262</span>\n            <span>\342\234\223 \320\247\320\270\321\201\321\202\321\213\320\271 \320\260\320\262\321\202\320\276\320\274\320\276\320\261\320\270\320\273\321\214 \320\261\320\265\320\267 \321\201\320\277\320\265\321\206\321\201\320\270\320\263\320\275\320\260\320\273\320\276\320\262</span>\n            <span>\342\234\223 100% \321\201\320\276\321\205\321\200\320\260\320\275\320\265\320\275\320\270\320\265 \321\202\320\260\320\271\320\275\321\213</span>\n          </div>\n        </div>\n      </section>\n\n      {/* Official Footnote / Disclaimer (crucial for medical landing pages) */}\n      <footer className=\"bg-stone-950 border-t border-stone-900 py-12 text-xs text-stone-500 font-sans\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n          \n          <div className=\"flex flex-col md:flex-row justify-between items-center gap-6\">\n            {/* Logo */}\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-base\">\n                \342\231\245\n              </div>\n              <div>\n                <div className=\"flex items-center gap-1\">\n                  <span className=\"font-bold text-white text-sm\">FAMILY</span>\n                  <span className=\"bg-emerald-500 text-stone-950 text-[10px] font-black px-1.5 py-0.5 rounded\">REHUB</span>\n                </div>\n                <p className=\"text-[8px] text-stone-400\">\320\247\320\260\321\201\321\202\320\275\320\260\321\217 \320\275\320\260\321\200\320\272\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\320\260\321\217 \320\270 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\320\260\321\217 \320\277\320\276\320\274\320\276\321\211\321\214</p>\n              </div>\n            </div>\n\n            {/* Licences */}\n            <div className=\"text-center md:text-right max-w-md\">\n              <p className=\"leading-relaxed\">\n                \320\233\320\270\321\206\320\265\320\275\320\267\320\270\321\217 \320\275\320\260 \320\276\321\201\321\203\321\211\320\265\321\201\321\202\320\262\320\273\320\265\320\275\320\270\320\265 \320\274\320\265\320\264\320\270\321\206\320\270\320\275\321\201\320\272\320\276\320\271 \320\264\320\265\321\217\321\202\320\265\320\273\321\214\320\275\320\276\321\201\321\202\320\270 \342\204\226 \320\233\320\236-77-01-018247 \320\276\321\202 12 \320\264\320\265\320\272\320\260\320\261\321\200\321\217 2021 \320\263. \320\262\321\213\320\264\320\260\320\275\320\260 \320\224\320\265\320\277\320\260\321\200\321\202\320\260\320\274\320\265\320\275\321\202\320\276\320\274 \320\267\320\264\321\200\320\260\320\262\320\276\320\276\321\205\321\200\320\260\320\275\320\265\320\275\320\270\321\217 \320\263\320\276\321\200\320\276\320\264\320\260 \320\234\320\276\321\201\320\272\320\262\321\213.\n              </p>\n            </div>\n          </div>\n\n          {/* Core Warning Badge for Medical landing (Law compliance) */}\n          <div className=\"p-4 border border-dashed border-stone-900 bg-stone-950 rounded-xl text-center text-[10px] sm:text-xs tracking-wider uppercase font-bold text-stone-600\">\n            \320\230\320\234\320\225\320\256\320\242\320\241\320\257 \320\237\320\240\320\236\320\242\320\230\320\222\320\236\320\237\320\236\320\232\320\220\320\227\320\220\320\235\320\230\320\257. \320\235\320\225\320\236\320\221\320\245\320\236\320\224\320\230\320\234\320\220 \320\232\320\236\320\235\320\241\320\243\320\233\320\254\320\242\320\220\320\246\320\230\320\257 \320\241\320\237\320\225\320\246\320\230\320\220\320\233\320\230\320\241\320\242\320\220\n          </div>\n\n          <div className=\"flex flex-col sm:flex-row justify-between items-center gap-4 pt-4 border-t border-stone-900 text-[11px]\">\n            <p>\302\251 {new Date().getFullYear()} FAMILY REHUB. \320\222\321\201\320\265 \320\277\321\200\320\260\320\262\320\260 \320\267\320\260\321\211\320\270\321\211\320\265\320\275\321\213. \320\230\320\275\321\204\320\276\321\200\320\274\320\260\321\206\320\270\321\217 \320\275\320\260 \321\201\320\260\320\271\321\202\320\265 \320\275\320\265 \321\217\320\262\320\273\321\217\320\265\321\202\321\201\321\217 \320\277\321\203\320\261\320\273\320\270\321\207\320\275\320\276\320\271 \320\276\321\204\320\265\321\200\321\202\320\276\320\271.</p>\n            <div className=\"flex gap-4\">\n              <a href=\"#\" className=\"hover:text-stone-300\">\320\237\320\276\320\273\320\270\321\202\320\270\320\272\320\260 \320\272\320\276\320\275\321\204\320\270\320\264\320\265\320\275\321\206\320\270\320\260\320\273\321\214\320\275\320\276\321\201\321\202\320\270</a>\n              <a href=\"#\" className=\"hover:text-stone-300\">\320\241\320\276\320\263\320\273\320\260\321\201\320\270\320\265 \320\275\320\260 \320\276\320\261\321\200\320\260\320\261\320\276\321\202\320\272\321\203 \320\277\320\265\321\200\321\201\320\276\320\275\320\260\320\273\321\214\320\275\321\213\321\205 \320\264\320\260\320\275\320\275\321\213\321\205</a>\n            </div>\n          </div>\n\n        </div>\n      </footer>\n\n      {/* Consultation / Booking Modal */}\n      <ConsultationModal\n        isOpen={isConsultationOpen}\n        onClose={() => setIsConsultationOpen(false)}\n        prefilledContext={modalContext}\n      />\n\n    </div>\n  );\n}\n"
