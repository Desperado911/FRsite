    instruction: "Replacing About Center styling precisely"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Section: About Center / Family Systemic Therapy */}\n      <section id=\"about-center\" className=\"py-24 bg-stone-950\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n            \n            {/* Left Column: Therapy Image */}\n            <div className=\"lg:col-span-5 relative order-last lg:order-first\">\n              <div className=\"relative bg-stone-900 border border-stone-850 p-3 rounded-3xl shadow-2xl overflow-hidden group\">\n                <img\n                  src=\"/src/assets/images/family_rehub_therapy_1783502249013.jpg\"\n                  alt=\"FAMILY REHUB \320\223\321\200\321\203\320\277\320\277\320\276\320\262\320\260\321\217 \321\201\320\265\320\274\320\265\320\271\320\275\320\260\321\217 \321\202\320\265\321\200\320\260\320\277\320\270\321\217\"\n                  className=\"w-full h-[320px] object-cover rounded-2xl transition-transform duration-700 group-hover:scale-102\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                \n                {/* Overlay Badge */}\n                <div className=\"absolute top-6 left-6 bg-emerald-600/90 text-white backdrop-blur-md px-3.5 py-1.5 rounded-xl text-xs font-semibold shadow-md flex items-center gap-1.5\">\n                  <Star className=\"w-4 h-4 fill-white\" />\n                  \320\243\321\216\321\202\320\275\320\260\321\217 \321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202\320\270\321\207\320\265\321\201\320\272\320\260\321\217 \320\260\321\202\320\274\320\276\321\201\321\204\320\265\321\200\320\260\n                </div>\n              </div>\n            </div>\n\n            {/* Right Column: Concept Explanation */}\n            <div className=\"lg:col-span-7 space-y-6\">\n              <span className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider\">\n                <HeartHandshake className=\"w-4 h-4\" /> \320\241\320\265\320\274\320\265\320\271\320\275\321\213\320\271 \321\201\320\270\321\201\321\202\320\265\320\274\320\275\321\213\320\271 \320\277\320\276\320\264\321\205\320\276\320\264\n              </span>\n              <h2 className=\"text-3xl md:text-4xl font-sans font-bold text-white tracking-tight leading-tight\">\n                \320\237\320\276\321\207\320\265\320\274\321\203 \320\274\321\213 \320\275\320\260\320\267\321\213\320\262\320\260\320\265\320\274\321\201\321\217 FAMILY REHUB?\n              </h2>\n              <p className=\"text-stone-300 text-sm md:text-base leading-relaxed\">\n                \320\227\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\321\214 \320\275\320\270\320\272\320\276\320\263\320\264\320\260 \320\275\320\265 \321\200\320\260\320\267\320\262\320\270\320\262\320\260\320\265\321\202\321\201\321\217 \320\262 \320\262\320\260\320\272\321\203\321\203\320\274\320\265. \320\255\321\202\320\276 <strong>\321\201\320\265\320\274\320\265\320\271\320\275\320\260\321\217 \320\261\320\276\320\273\320\265\320\267\320\275\321\214</strong>. \320\232\320\276\320\263\320\264\320\260 \320\276\320\264\320\270\320\275 \320\270\320\267 \321\207\320\273\320\265\320\275\320\276\320\262 \321\201\320\265\320\274\321\214\320\270 \321\201\321\202\321\200\320\260\320\264\320\260\320\265\321\202 \320\260\320\273\320\272\320\276\320\263\320\276\320\273\320\270\320\267\320\274\320\276\320\274, \320\275\320\260\321\200\320\272\320\276\320\274\320\260\320\275\320\270\320\265\320\271 \320\270\320\273\320\270 \320\270\320\263\321\200\320\276\320\274\320\260\320\275\320\270\320\265\320\271, \320\262\321\201\320\265 \321\200\320\276\320\264\321\201\321\202\320\262\320\265\320\275\320\275\320\270\320\272\320\270 \320\262\320\276\320\262\320\273\320\265\320\272\320\260\321\216\321\202\321\201\321\217 \320\262 \320\264\320\265\321\201\321\202\321\200\321\203\320\272\321\202\320\270\320\262\320\275\321\203\321\216 \321\201\320\270\321\201\321\202\320\265\320\274\321\203 \321\201\320\276\320\267\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\320\270. \n              </p>\n              <p className=\"text-stone-300 text-sm md:text-base leading-relaxed\">\n                \320\236\320\261\321\213\321\207\320\275\321\213\320\265 \320\272\320\273\320\270\320\275\320\270\320\272\320\270 \320\270\320\267\320\276\320\273\320\270\321\200\321\203\321\216\321\202 \320\277\320\260\321\206\320\270\320\265\320\275\321\202\320\260, \320\272\320\260\320\277\320\260\321\216\321\202 \320\265\320\263\320\276 \320\273\320\265\320\272\320\260\321\200\321\201\321\202\320\262\320\260\320\274\320\270, \320\260 \320\277\320\276\321\201\320\273\320\265 \320\262\320\276\320\267\320\262\321\200\320\260\321\211\320\265\320\275\320\270\321\217 \320\264\320\276\320\274\320\276\320\271 \320\262 \321\202\321\203 \320\266\320\265 \321\202\321\200\320\265\320\262\320\276\320\266\320\275\321\203\321\216 \320\260\321\202\320\274\320\276\321\201\321\204\320\265\321\200\321\203 \320\276\320\275 \320\275\320\265\320\270\320\267\320\261\320\265\320\266\320\275\320\276 \321\201\321\200\321\213\320\262\320\260\320\265\321\202\321\201\321\217. \320\234\321\213 \320\264\320\265\320\271\321\201\321\202\320\262\321\203\320\265\320\274 \320\270\320\275\320\260\321\207\320\265.\n              </p>\n              \n              {/* Feature Bullet Points */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-4\">\n                <div className=\"flex gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/10\">\n                    \342\234\223\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-xs md:text-sm text-white\">\320\240\320\265\320\260\320\261\320\270\320\273\320\270\321\202\320\260\321\206\320\270\321\217 \320\262\321\201\320\265\320\271 \321\201\320\265\320\274\321\214\320\270</h4>\n                    <p className=\"text-stone-400 text-xs leading-normal mt-0.5\">\320\237\320\260\321\200\320\260\320\273\320\273\320\265\320\273\321\214\320\275\320\276 \320\277\321\200\320\276\320\262\320\276\320\264\320\270\320\274 \320\267\320\260\320\272\321\200\321\213\321\202\321\213\320\265 \321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202\320\270\321\207\320\265\321\201\320\272\320\270\320\265 \321\201\320\265\321\201\321\201\320\270\320\270 \320\270 \320\262\320\265\320\261\320\270\320\275\320\260\321\200\321\213 \320\264\320\273\321\217 \321\201\320\276\320\267\320\260\320\262\320\270\321\201\320\270\320\274\321\213\321\205 \321\200\320\276\320\264\321\201\321\202\320\262\320\265\320\275\320\275\320\270\320\272\320\276\320\262.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/10\">\n                    \342\234\223\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-xs md:text-sm text-white\">\320\230\321\201\321\206\320\265\320\273\320\265\320\275\320\270\320\265 \320\276\321\202 \321\207\321\203\320\262\321\201\321\202\320\262\320\260 \320\262\320\270\320\275\321\213</h4>\n                    <p className=\"text-stone-400 text-xs leading-normal mt-0.5\">\320\237\320\276\320\274\320\276\320\263\320\260\320\265\320\274 \320\274\320\260\321\202\320\265\321\200\321\217\320\274 \320\270 \321\201\321\203\320\277\321\200\321\203\320\263\320\260\320\274 \320\270\320\267\320\261\320\260\320\262\320\270\321\202\321\214\321\201\321\217 \320\276\321\202 \320\263\320\270\320\277\320\265\321\200\320\276\320\277\320\265\320\272\320\270, \320\275\320\260\321\203\321\207\320\270\321\202\321\214\321\201\321\217 \321\201\321\202\320\260\320\262\320\270\321\202\321\214 \320\263\321\200\320\260\320\275\320\270\321\206\321\213 \320\270 \321\201\320\275\320\276\320\262\320\260 \320\266\320\270\321\202\321\214 \321\201\320\262\320\276\320\265\320\271 \320\266\320\270\320\267\320\275\321\214\321\216.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/10\">\n                    \342\234\223\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-xs md:text-sm text-white\">\320\240\320\260\320\267\321\200\321\203\321\210\320\265\320\275\320\270\320\265 \321\201\321\202\320\260\321\200\321\213\321\205 \321\202\321\200\320\270\320\263\320\263\320\265\321\200\320\276\320\262</h4>\n                    <p className=\"text-stone-400 text-xs leading-normal mt-0.5\">\320\243\321\207\320\270\320\274 \321\201\320\265\320\274\321\214\321\216 \320\272\320\276\320\274\320\274\321\203\320\275\320\270\321\206\320\270\321\200\320\276\320\262\320\260\321\202\321\214 \320\261\320\265\320\267 \320\276\320\261\320\270\320\264, \320\277\321\200\320\265\321\202\320\265\320\275\320\267\320\270\320\271 \320\270 \320\274\320\260\320\275\320\270\320\277\321\203\320\273\321\217\321\206\320\270\320\271 \342\200\224 \320\263\320\273\320\260\320\262\320\275\320\276\320\263\320\276 \321\202\320\276\320\277\320\273\320\270\320\262\320\260 \320\264\320\273\321\217 \320\261\321\203\320\264\321\203\321\211\320\270\321\205 \321\201\321\200\321\213\320\262\320\276\320\262.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/10\">\n                    \342\234\223\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-xs md:text-sm text-white\">\320\221\320\265\321\200\320\265\320\266\320\275\320\260\321\217 \321\201\320\276\321\206\320\270\320\260\320\273\320\270\320\267\320\260\321\206\320\270\321\217</h4>\n                    <p className=\"text-stone-400 text-xs leading-normal mt-0.5\">\320\237\320\276\321\201\320\273\320\265 \320\262\321\213\320\277\320\270\321\201\320\272\320\270 \320\274\321\213 \321\201\320\276\320\277\321\200\320\276\320\262\320\276\320\266\320\264\320\260\320\265\320\274 \321\201\320\265\320\274\321\214\321\216 \320\262 \321\202\320\265\321\207\320\265\320\275\320\270\320\265 1 \320\263\320\276\320\264\320\260 \342\200\224 \320\264\320\260\320\265\320\274 \320\261\320\265\321\200\320\265\320\266\320\275\321\203\321\216 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\270\321\207\320\265\321\201\320\272\321\203\321\216 \320\277\320\276\320\264\320\264\320\265\321\200\320\266\320\272\321\203.</p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"pt-4\">\n                <button\n                  id=\"about-action\"\n                  onClick={() => openConsultation(\'\320\227\320\260\320\277\321\200\320\276\321\201 \320\275\320\260 \320\272\320\276\320\275\321\201\321\203\320\273\321\214\321\202\320\260\321\206\320\270\321\216 \320\277\320\276 \321\201\320\265\320\274\320\265\320\271\320\275\320\276\320\274\321\203 \320\277\320\276\320\264\321\205\320\276\320\264\321\203\')}\n                  className=\"bg-stone-900 hover:bg-stone-850 text-stone-200 border border-stone-800 hover:border-stone-700 font-bold py-3.5 px-6 rounded-xl transition-all cursor-pointer text-xs md:text-sm\"\n                >\n                  \320\243\320\267\320\275\320\260\321\202\321\214 \320\261\320\276\320\273\321\214\321\210\320\265 \320\276 \321\201\320\265\320\274\320\265\320\271\320\275\320\276\320\271 \320\277\321\200\320\276\320\263\321\200\320\260\320\274\320\274\320\265\n                </button>\n              </div>\n\n            </div>\n\n          </div>\n        </div>\n      </section>"
        replacement_content: "      {/* Section: About Center / Family Systemic Therapy */}\n      <section id=\"about-center\" className=\"py-24 bg-bg-primary\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n            \n            {/* Left Column: Therapy Image */}\n            <div className=\"lg:col-span-5 relative order-last lg:order-first\">\n              <div className=\"relative bg-bg-secondary border border-border-custom p-4 overflow-hidden group\">\n                <img\n                  src=\"/src/assets/images/family_rehub_therapy_1783502249013.jpg\"\n                  alt=\"FAMILY REHUB \320\223\321\200\321\203\320\277\320\277\320\276\320\262\320\260\321\217 \321\201\320\265\320\274\320\265\320\271\320\275\320\260\321\217 \321\202\320\265\321\200\320\260\320\277\320\270\321\217\"\n                  className=\"w-full h-[320px] object-cover transition-all duration-700 group-hover:scale-102\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                \n                {/* Overlay Badge */}\n                <div className=\"absolute top-6 left-6 bg-accent text-bg-primary px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5 border border-accent\">\n                  <Star className=\"w-4 h-4 fill-bg-primary\" />\n                  \320\243\321\216\321\202\320\275\320\260\321\217 \320\260\321\202\320\274\320\276\321\201\321\204\320\265\321\200\320\260 \321\206\320\265\320\275\321\202\321\200\320\260\n                </div>\n              </div>\n            </div>\n\n            {/* Right Column: Concept Explanation */}\n            <div className=\"lg:col-span-7 space-y-6\">\n              <span className=\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-accent-light text-accent text-xs font-semibold uppercase tracking-wider border border-border-custom\">\n                <HeartHandshake className=\"w-4 h-4\" /> \320\241\320\265\320\274\320\265\320\271\320\275\321\213\320\271 \321\201\320\270\321\201\321\202\320\265\320\274\320\275\321\213\320\271 \320\277\320\276\320\264\321\205\320\276\320\264\n              </span>\n              <h2 className=\"text-3xl md:text-4xl font-serif font-semibold text-text-primary tracking-tight leading-tight\">\n                \320\237\320\276\321\207\320\265\320\274\321\203 \320\274\321\213 \320\275\320\260\320\267\321\213\320\262\320\260\320\265\320\274\321\201\321\217 FAMILY REHUB?\n              </h2>\n              <p className=\"text-text-primary/90 text-sm md:text-base leading-relaxed\">\n                \320\227\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\321\214 \320\275\320\270\320\272\320\276\320\263\320\264\320\260 \320\275\320\265 \321\200\320\260\320\267\320\262\320\270\320\262\320\260\320\265\321\202\321\201\321\217 \320\262 \320\262\320\260\320\272\321\203\321\203\320\274\320\265. \320\255\321\202\320\276 <strong>\321\201\320\265\320\274\320\265\320\271\320\275\320\260\321\217 \320\261\320\276\320\273\320\265\320\267\320\275\321\214</strong>. \320\232\320\276\320\263\320\264\320\260 \320\276\320\264\320\270\320\275 \320\270\320\267 \321\207\320\273\320\265\320\275\320\276\320\262 \321\201\320\265\320\274\321\214\320\270 \321\201\321\202\321\200\320\260\320\264\320\260\320\265\321\202 \320\260\320\273\320\272\320\276\320\263\320\276\320\273\320\270\320\267\320\274\320\276\320\274, \320\275\320\260\321\200\320\272\320\276\320\274\320\260\320\275\320\270\320\265\320\271 \320\270\320\273\320\270 \320\270\320\263\321\200\320\276\320\274\320\260\320\275\320\270\320\265\320\271, \320\262\321\201\320\265 \321\200\320\276\320\264\321\201\321\202\320\262\320\265\320\275\320\275\320\270\320\272\320\270 \320\262\320\276\320\262\320\273\320\265\320\272\320\260\321\216\321\202\321\201\321\217 \320\262 \320\264\320\265\321\201\321\202\321\200\321\203\320\272\321\202\320\270\320\262\320\275\321\203\321\216 \321\201\320\270\321\201\321\202\320\265\320\274\321\203 \321\201\320\276\320\267\320\260\320\262\320\270\321\201\320\270\320\274\320\276\321\201\321\202\320\270. \n              </p>\n              <p className=\"text-text-primary/90 text-sm md:text-base leading-relaxed\">\n                \320\236\320\261\321\213\321\207\320\275\321\213\320\265 \320\272\320\273\320\270\320\275\320\270\320\272\320\270 \320\270\320\267\320\276\320\273\320\270\321\200\321\203\321\216\321\202 \320\277\320\260\321\206\320\270\320\265\320\275\321\202\320\260, \320\272\320\260\320\277\320\260\321\216\321\202 \320\265\320\263\320\276 \320\273\320\265\320\272\320\260\321\200\321\201\321\202\320\262\320\260\320\274\320\270, \320\260 \320\277\320\276\321\201\320\273\320\265 \320\262\320\276\320\267\320\262\321\200\320\260\321\211\320\265\320\275\320\270\321\217 \320\264\320\276\320\274\320\276\320\271 \320\262 \321\202\321\203 \320\266\320\265 \321\202\321\200\320\265\320\262\320\276\320\266\320\275\321\203\321\216 \320\260\321\202\320\274\320\276\321\201\321\204\320\265\321\200\321\203 \320\276\320\275 \320\275\320\265\320\270\320\267\320\261\320\265\320\266\320\275\320\276 \321\201\321\200\321\213\320\262\320\260\320\265\321\202\321\201\321\217. \320\234\321\213 \320\264\320\265\320\271\321\201\321\202\320\262\321\203\320\265\320\274 \320\270\320\275\320\260\321\207\320\265.\n              </p>\n              \n              {/* Feature Bullet Points */}\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-4\">\n                <div className=\"flex gap-3\">\n                  <div className=\"w-8 h-8 bg-accent-light text-accent flex items-center justify-center shrink-0 border border-border-custom text-sm font-bold\">\n                    \342\234\223\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-xs md:text-sm text-text-primary\">\320\240\320\265\320\260\320\261\320\270\320\273\320\270\321\202\3