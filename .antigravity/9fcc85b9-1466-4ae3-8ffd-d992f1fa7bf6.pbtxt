        lines {
          text: "    answer: \"\320\222 \320\277\320\265\321\200\320\262\321\213\320\265 14 \320\264\320\275\320\265\320\271 (\320\277\320\265\321\200\320\270\320\276\320\264 \320\276\321\201\321\202\321\200\320\276\320\271 \320\260\320\264\320\260\320\277\321\202\320\260\321\206\320\270\320\270) \320\272\320\276\320\275\321\202\320\260\320\272\321\202\321\213 \320\276\320\263\321\200\320\260\320\275\320\270\321\207\320\265\320\275\321\213, \321\207\321\202\320\276\320\261\321\213 \321\200\320\265\320\267\320\270\320\264\320\265\320\275\321\202 \321\201\321\204\320\276\320\272\321\203\321\201\320\270\321\200\320\276\320\262\320\260\320\273\321\201\321\217 \320\275\320\260 \321\202\320\265\321\200\320\260\320\277\320\270\320\270. \320\224\320\260\320\273\320\265\320\265 \320\272\320\260\320\266\320\264\320\276\320\265 \320\262\320\276\321\201\320\272\321\200\320\265\321\201\320\265\320\275\321\214\320\265 \321\203 \320\275\320\260\321\201 \320\277\321\200\320\276\321\205\320\276\320\264\320\270\321\202 \'\320\241\320\265\320\274\320\265\320\271\320\275\321\213\320\271 \320\264\320\265\320\275\321\214\': \320\262\321\213 \320\274\320\276\320\266\320\265\321\202\320\265 \320\277\321\200\320\270\320\265\320\267\320\266\320\260\321\202\321\214, \320\276\320\261\321\211\320\260\321\202\321\214\321\201\321\217, \321\203\321\207\320\260\321\201\321\202\320\262\320\276\320\262\320\260\321\202\321\214 \320\262 \321\201\320\276\320\262\320\274\320\265\321\201\321\202\320\275\321\213\321\205 \321\202\320\265\321\200\320\260\320\277\320\265\320\262\321\202\320\270\321\207\320\265\321\201\320\272\320\270\321\205 \320\263\321\200\321\203\320\277\320\277\320\260\321\205 \320\277\320\276\320\264 \321\200\321\203\320\272\320\276\320\262\320\276\320\264\321\201\321\202\320\262\320\276\320\274 \321\201\320\265\320\274\320\265\320\271\320\275\320\276\320\263\320\276 \320\277\321\201\320\270\321\205\320\276\320\273\320\276\320\263\320\260.\""
